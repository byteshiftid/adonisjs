{
  "name": "@byteshiftid/adonisjs-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"@byteshiftid/adonisjs-*\" run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter \"@byteshiftid/adonisjs-*\" run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "catalog:",
    "@adonisjs/tsconfig": "catalog:",
    "@changesets/cli": "^3.0.3",
    "prettier": "catalog:"
  },
  "prettier": "@adonisjs/prettier-config"
}
