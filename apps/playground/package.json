{
  "name": "@byteshiftid/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#notifications/*": "./app/notifications/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "catalog:",
    "@adonisjs/eslint-config": "catalog:",
    "@adonisjs/prettier-config": "catalog:",
    "@adonisjs/tsconfig": "catalog:",
    "@japa/assert": "catalog:",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "catalog:",
    "@poppinss/ts-exec": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "catalog:",
    "@adonisjs/core": "catalog:",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "catalog:",
    "@adonisjs/mail": "catalog:",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@byteshiftid/adonisjs-audit-trail": "workspace:*",
    "@byteshiftid/adonisjs-notifications": "workspace:*",
    "@byteshiftid/adonisjs-tenant": "workspace:*",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "catalog:",
    "luxon": "catalog:",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
