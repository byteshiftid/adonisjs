# Test-only defaults. Committed on purpose: `node ace test` must run from a
# clean checkout without a local, gitignored `.env`. Values are not secrets.
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=test
LOG_LEVEL=error
APP_KEY=playground-test-only-app-key-0001
APP_URL=http://localhost:3333
SESSION_DRIVER=memory
