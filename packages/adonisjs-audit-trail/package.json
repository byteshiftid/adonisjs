{
  "name": "@byteshiftid/adonisjs-audit-trail",
  "description": "Production-grade, tamper-evident audit trail for AdonisJS v7",
  "version": "1.2.4",
  "homepage": "https://github.com/byteshiftid/adonisjs/tree/main/packages/adonisjs-audit-trail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteshiftid/adonisjs.git",
    "directory": "packages/adonisjs-audit-trail"
  },
  "bugs": {
    "url": "https://github.com/byteshiftid/adonisjs/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "files": [
    "build",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "!build/bin",
    "!build/tests",
    "!build/benchmarks",
    "!docs/IMPLEMENTATION_PLAN.md"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./auditable": "./build/src/mixins/auditable.js",
    "./audit_provider": "./build/providers/audit_provider.js",
    "./services/main": "./build/services/main.js",
    "./stores": "./build/src/stores/main.js",
    "./commands": "./build/commands/main.js",
    "./audit_context_middleware": "./build/src/middleware/audit_context_middleware.js",
    "./models/audit": "./build/src/models/audit.js"
  },
  "scripts": {
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "copy:commands": "copyfiles \"commands/commands.json\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "format": "prettier --write .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test": "c8 pnpm run quick:test",
    "bench": "node --import=@poppinss/ts-exec benchmarks/main.ts",
    "pretest": "pnpm run lint",
    "precompile": "pnpm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm run copy:templates && pnpm run copy:commands",
    "build": "pnpm run compile",
    "verify:exports": "node scripts/verify-exports.mjs",
    "e2e:consumer": "bash scripts/e2e-configure.sh --all",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "adonisjs-package",
    "adonisjs",
    "adonisjs-v7",
    "audit",
    "audit-trail",
    "audit-log",
    "lucid",
    "lucid-orm",
    "compliance",
    "tamper-evident",
    "security",
    "gdpr",
    "hipaa",
    "soc2",
    "sha256",
    "hash-chain",
    "siem",
    "outbox",
    "typescript"
  ],
  "sideEffects": false,
  "author": "Riko Riswandha Fahmi Prasetyo <rikorisw@gmail.com> (https://byteshift.id)",
  "license": "MIT",
  "devDependencies": {
    "@adonisjs/assembler": "catalog:",
    "@adonisjs/auth": "catalog:",
    "@adonisjs/core": "catalog:",
    "@adonisjs/eslint-config": "catalog:",
    "@adonisjs/lucid": "catalog:",
    "@adonisjs/prettier-config": "catalog:",
    "@adonisjs/tsconfig": "catalog:",
    "@japa/assert": "catalog:",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "catalog:",
    "@poppinss/ts-exec": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "^12.10.0",
    "c8": "catalog:",
    "copyfiles": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "luxon": "catalog:",
    "mysql2": "^3.22.5",
    "pg": "^8.21.0",
    "prettier": "catalog:",
    "testcontainers": "^12.0.2",
    "tinybench": "^6.0.2",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "luxon": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/auth": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./providers/audit_provider.ts",
      "./services/main.ts",
      "./src/types.ts",
      "./src/mixins/auditable.ts",
      "./src/stores/main.ts",
      "./src/middleware/audit_context_middleware.ts",
      "./src/models/audit.ts",
      "./commands/main.ts",
      "./commands/audit_verify.ts",
      "./commands/audit_prune.ts",
      "./commands/audit_replay_outbox.ts",
      "./commands/audit_stats.ts",
      "./commands/audit_forget.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "benchmarks/**",
      "bin/**",
      "build/**",
      "coverage/**",
      "examples/**",
      "eslint.config.js"
    ],
    "all": true,
    "check-coverage": true,
    "lines": 80,
    "functions": 81,
    "branches": 74,
    "statements": 80
  },
  "prettier": "@adonisjs/prettier-config"
}
