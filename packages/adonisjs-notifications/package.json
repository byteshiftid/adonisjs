{
  "name": "@byteshiftid/adonisjs-notifications",
  "description": "Send notifications through multiple channels with Laravel-inspired ergonomics for AdonisJS v7",
  "version": "1.5.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "src/ui/dashboard/spa/dist/index.html",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./types": {
      "types": "./build/src/types.d.ts",
      "default": "./build/src/types.js"
    },
    "./services/main": {
      "types": "./build/services/main.d.ts",
      "default": "./build/services/main.js"
    },
    "./notification_provider": {
      "types": "./build/providers/notification_provider.d.ts",
      "default": "./build/providers/notification_provider.js"
    },
    "./commands": {
      "types": "./build/commands/main.d.ts",
      "default": "./build/commands/main.js"
    },
    "./commands/*": {
      "types": "./build/commands/*.d.ts",
      "default": "./build/commands/*.js"
    },
    "./mixins": {
      "types": "./build/src/mixins/main.d.ts",
      "default": "./build/src/mixins/main.js"
    },
    "./testing": {
      "types": "./build/src/testing/main.d.ts",
      "default": "./build/src/testing/main.js"
    },
    "./channels/*": {
      "types": "./build/src/channels/*.d.ts",
      "default": "./build/src/channels/*.js"
    },
    "./jobs/*": {
      "types": "./build/src/jobs/*.d.ts",
      "default": "./build/src/jobs/*.js"
    },
    "./ui/dashboard": {
      "types": "./build/src/ui/dashboard/index.d.ts",
      "default": "./build/src/ui/dashboard/index.js"
    }
  },
  "scripts": {
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "copy:commands": "copyfiles \"commands/commands.json\" build",
    "copy:ui": "copyfiles -u 5 \"src/ui/dashboard/spa/dist/index.html\" \"build/src/ui/dashboard/spa/dist/\"",
    "generate:commands": "node --import=@poppinss/ts-exec scripts/generate_commands_manifest.ts",
    "build:ui": "cd src/ui/dashboard/spa && npm install && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm run lint",
    "test": "c8 pnpm run quick:test",
    "precompile": "pnpm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm run generate:commands && pnpm run copy:commands && pnpm run copy:templates && pnpm run copy:ui",
    "build": "pnpm run compile",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "adonisjs",
    "adonisjs-package",
    "notifications",
    "mail",
    "database",
    "queue",
    "channels",
    "laravel-notifications",
    "test-fakes",
    "inbox",
    "messaging"
  ],
  "license": "MIT",
  "devDependencies": {
    "@adonisjs/assembler": "catalog:",
    "@adonisjs/core": "catalog:",
    "@adonisjs/eslint-config": "catalog:",
    "@adonisjs/lucid": "catalog:",
    "@adonisjs/mail": "catalog:",
    "@adonisjs/queue": "catalog:",
    "@adonisjs/prettier-config": "catalog:",
    "@adonisjs/tsconfig": "catalog:",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "catalog:",
    "@japa/runner": "catalog:",
    "@poppinss/ts-exec": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "c8": "catalog:",
    "copyfiles": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "luxon": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/queue": "~0.6.2"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/mail": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "@adonisjs/queue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./services/main.ts",
      "./providers/notification_provider.ts",
      "./src/types.ts",
      "./src/channels/index.ts",
      "./src/channels/database_channel.ts",
      "./src/channels/log_channel.ts",
      "./src/channels/mail_channel.ts",
      "./src/channels/null_channel.ts",
      "./src/mixins/main.ts",
      "./src/jobs/send_notification_job.ts",
      "./src/testing/main.ts",
      "./commands/main.ts",
      "./commands/make_notification.ts",
      "./src/ui/dashboard/index.ts",
      "./commands/notifications_prune.ts",
      "./commands/notifications_retry_failed.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext",
    "deps": {
      "neverBundle": [
        "@byteshiftid/adonisjs-notifications/services/main"
      ]
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "author": "Riko Riswandha Fahmi Prasetyo <rikorisw@gmail.com> (https://byteshift.id)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteshiftid/adonisjs.git",
    "directory": "packages/adonisjs-notifications"
  },
  "homepage": "https://github.com/byteshiftid/adonisjs/tree/main/packages/adonisjs-notifications#readme",
  "bugs": {
    "url": "https://github.com/byteshiftid/adonisjs/issues"
  }
}
